# ── dunnflow — root .gitignore (frontend + backend) ──────────────────────────

# ───────────────────────── Environment / secrets ─────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ───────────────────────────── Frontend (Vite/React) ─────────────────────────
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/.vite/
frontend/vite.config.*.timestamp-*
frontend/*.tsbuildinfo
frontend/*-debug.log*
frontend/logs/
frontend/*.log
frontend/.claude-replay.*
frontend/.tmp-*
node_modules/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───────────────────────────── Backend (Python/FastAPI) ──────────────────────
backend/__pycache__/
backend/**/__pycache__/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
backend/.pytest_cache/
.pytest_cache/
backend/.hypothesis/
.hypothesis/
backend/.mypy_cache/
.mypy_cache/
backend/.ruff_cache/
.ruff_cache/
backend/htmlcov/
htmlcov/
.coverage
.coverage.*
coverage.xml
backend/*.egg-info/
*.egg-info/
backend/build/
backend/dist/

# Python virtual environments
.venv/
venv/
env/
ENV/

# ───────────────────────────── Databases / local state ───────────────────────
*.sqlite3
*.db
pgdata/

# ───────────────────────────── Editors / OS ───────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Platform-managed agent/tool state, not project source.
/.plugins/
/.opencode-skills/
/.claude/settings.local.json

docs/ARCHITECTURE_DIAGRAM.md
docs/IMPLEMENTATION_PLAN.md
docs/SYSTEM_ARCHITECTURE.md



